<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane styleClass="erp-root" prefHeight="600.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.GestionDiariaController"
            stylesheets="@/resource/styles.css">
    <children>
        <VBox styleClass="erp-page" AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0">
            <children>
                <Label text="📅 GESTIÓN DIARIA DE TURNOS" styleClass="erp-title" />

                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="erp-card">
                    <children>
                        <Label text="Seleccionar Fecha:" />
                        <DatePicker fx:id="dpFecha" promptText="Seleccionar Fecha" />
                        <Label text="Estilista:" />
                        <ComboBox fx:id="cbEstilistaFiltro" prefWidth="190.0" promptText="Mostrar Todos" />
                        <Button text="🔎 Recargar Agenda" onAction="#cargarAgenda" styleClass="action-button" />
                    </children>
                </HBox>

                <TableView fx:id="tvTurnos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colFecha" text="Fecha" prefWidth="80.0" />
                        <TableColumn fx:id="colHora" text="Hora" prefWidth="70.0" />
                        <TableColumn fx:id="colCliente" text="Cliente" prefWidth="180.0" />
                        <TableColumn fx:id="colEstilista" text="Estilista" prefWidth="120.0" />
                        <TableColumn fx:id="colServicios" text="Servicios" prefWidth="250.0" />
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="85.0" />
                        <TableColumn fx:id="colMotivoLog" text="Log/Motivo" prefWidth="100.0" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="erp-action-bar">
                    <children>
                        <Button fx:id="btnConfirmar" text="✔️ Confirmar Turno" onAction="#handleConfirmarTurno"
                                styleClass="action-button" />

                        <Button fx:id="btnCancelar" text="❌ Cancelar Turno" onAction="#handleCancelarTurno"
                                styleClass="danger-button" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
