<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AltaProfesionalController"
            styleClass="erp-root"
            stylesheets="@/resource/styles.css">

    <children>

        <ScrollPane fitToWidth="true"
                    fitToHeight="false"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0">

            <content>

                <VBox styleClass="erp-page"
                      fillWidth="true">

                    <children>

                        <!-- TÍTULO -->
                        <Label text="ALTA PROFESIONAL"
                               styleClass="label-header"/>


                        <!-- ========================= -->
                        <!-- DATOS PERSONALES -->
                        <!-- ========================= -->

                        <VBox styleClass="erp-card">
<Label text="DATOS PERSONALES"
                               styleClass="label-section"/>

                        <GridPane hgap="10.0"
                                  vgap="10.0">
<columnConstraints><ColumnConstraints minWidth="110" prefWidth="130"/><ColumnConstraints hgrow="ALWAYS" minWidth="140"/><ColumnConstraints minWidth="110" prefWidth="130"/><ColumnConstraints hgrow="ALWAYS" minWidth="140"/></columnConstraints>

                            <children>

                                <Label text="Nombre:"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="0"/>

                                <TextField fx:id="txtNombre"
                                           promptText="Nombre"
                                           styleClass="text-field"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="0"/>

                                <Label text="Apellido:"
                                       GridPane.columnIndex="2"
                                       GridPane.rowIndex="0"/>

                                <TextField fx:id="txtApellido"
                                           promptText="Apellido"
                                           styleClass="text-field"
                                           GridPane.columnIndex="3"
                                           GridPane.rowIndex="0"/>


                                <Label text="Teléfono:"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="1"/>

                                <TextField fx:id="txtTelefono"
                                           promptText="Teléfono"
                                           styleClass="text-field"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="1"/>

                                <Label text="Email:"
                                       GridPane.columnIndex="2"
                                       GridPane.rowIndex="1"/>

                                <TextField fx:id="txtEmail"
                                           promptText="Email"
                                           styleClass="text-field"
                                           GridPane.columnIndex="3"
                                           GridPane.rowIndex="1"/>

                            </children>

                        </GridPane>


                        <!-- ========================= -->
                        <!-- DOCUMENTACIÓN -->
                        <!-- ========================= -->
</VBox>

                        <VBox styleClass="erp-card">
<Label text="DOCUMENTACIÓN"
                               styleClass="label-section"/>

                        <GridPane hgap="10.0"
                                  vgap="10.0">
<columnConstraints><ColumnConstraints minWidth="110" prefWidth="130"/><ColumnConstraints hgrow="ALWAYS" minWidth="140"/><ColumnConstraints minWidth="110" prefWidth="130"/><ColumnConstraints hgrow="ALWAYS" minWidth="140"/></columnConstraints>

                            <children>

                                <Label text="Tipo documento:"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="0"/>

                                <ComboBox maxWidth="1.7976931348623157E308" fx:id="cmbTipoDocumento"
                                          promptText="Seleccionar"
                                          styleClass="combo-box"
                                          prefWidth="200.0"
                                          GridPane.columnIndex="1"
                                          GridPane.rowIndex="0"/>


                                <Label text="N° Documento:"
                                       GridPane.columnIndex="2"
                                       GridPane.rowIndex="0"/>

                                <TextField fx:id="txtNumeroDocumento"
                                           promptText="DNI"
                                           styleClass="text-field"
                                           GridPane.columnIndex="3"
                                           GridPane.rowIndex="0"/>

                            </children>

                        </GridPane>


                        <!-- ========================= -->
                        <!-- DOMICILIO -->
                        <!-- ========================= -->
</VBox>

                        <VBox styleClass="erp-card">
<Label text="DOMICILIO"
                               styleClass="label-section"/>

                        <GridPane hgap="10.0"
                                  vgap="10.0">
<columnConstraints><ColumnConstraints minWidth="110" prefWidth="130"/><ColumnConstraints hgrow="ALWAYS" minWidth="140"/><ColumnConstraints minWidth="110" prefWidth="130"/><ColumnConstraints hgrow="ALWAYS" minWidth="140"/></columnConstraints>

                            <children>

                                <Label text="Provincia:"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="0"/>

                                <ComboBox maxWidth="1.7976931348623157E308" fx:id="cmbProvincia"
                                          promptText="Seleccionar"
                                          styleClass="combo-box"
                                          prefWidth="200.0"
                                          GridPane.columnIndex="1"
                                          GridPane.rowIndex="0"/>


                                <Label text="Ciudad:"
                                       GridPane.columnIndex="2"
                                       GridPane.rowIndex="0"/>

                                <ComboBox maxWidth="1.7976931348623157E308" fx:id="cmbCiudad"
                                          promptText="Seleccionar"
                                          styleClass="combo-box"
                                          prefWidth="200.0"
                                          GridPane.columnIndex="3"
                                          GridPane.rowIndex="0"/>


                                <Label text="Barrio:"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="1"/>

                                <ComboBox maxWidth="1.7976931348623157E308" fx:id="cmbBarrio"
                                          promptText="Seleccionar"
                                          styleClass="combo-box"
                                          prefWidth="200.0"
                                          GridPane.columnIndex="1"
                                          GridPane.rowIndex="1"/>


                                <Label text="Calle:"
                                       GridPane.columnIndex="2"
                                       GridPane.rowIndex="1"/>

                                <TextField fx:id="txtCalle"
                                           promptText="Calle"
                                           styleClass="text-field"
                                           GridPane.columnIndex="3"
                                           GridPane.rowIndex="1"/>


                                <Label text="Número:"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="2"/>

                                <TextField fx:id="txtNumero"
                                           promptText="Número"
                                           styleClass="text-field"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="2"/>

                            </children>

                        </GridPane>


                        <!-- ========================= -->
                        <!-- DATOS PROFESIONALES -->
                        <!-- ========================= -->
</VBox>

                        <VBox styleClass="erp-card">
<Label text="DATOS PROFESIONALES"
                               styleClass="label-section"/>

                        <GridPane hgap="10.0"
                                  vgap="10.0">
<columnConstraints><ColumnConstraints minWidth="110" prefWidth="130"/><ColumnConstraints hgrow="ALWAYS" minWidth="140"/><ColumnConstraints minWidth="110" prefWidth="130"/><ColumnConstraints hgrow="ALWAYS" minWidth="140"/></columnConstraints>

                            <children>

                                <Label text="Fecha de ingreso:"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="0"/>

                                <DatePicker maxWidth="1.7976931348623157E308" fx:id="dpFechaIngreso"
                                            prefWidth="200.0"
                                            GridPane.columnIndex="1"
                                            GridPane.rowIndex="0"/>


                                <Label text="Comisión (%):"
                                       GridPane.columnIndex="2"
                                       GridPane.rowIndex="0"/>

                                <TextField fx:id="txtPorcentajeComision"
                                           promptText="Ej. 30"
                                           styleClass="text-field"
                                           GridPane.columnIndex="3"
                                           GridPane.rowIndex="0"/>

                            </children>

                        </GridPane>


                        <!-- ========================= -->
                        <!-- ESPECIALIDADES -->
                        <!-- ========================= -->
</VBox>

                        <VBox styleClass="erp-card">
<Label text="ESPECIALIDADES"
                               styleClass="label-section"/>

                        <HBox spacing="10.0">

                            <children>

                                <ComboBox fx:id="cmbEspecialidad"
                                          promptText="Seleccionar especialidad"
                                          prefWidth="250.0"
                                          styleClass="combo-box"/>

                                <Button fx:id="btnAgregarEspecialidad"
                                        text="AGREGAR"
                                        prefWidth="100.0"
                                        styleClass="action-button"
                                        onAction="#agregarEspecialidad"/>

                            </children>

                        </HBox>


                        <ListView fx:id="lstEspecialidades"
                                  prefHeight="110.0"
                                  maxHeight="110.0"/>


                        <!-- ========================= -->
                        <!-- DISPONIBILIDAD -->
                        <!-- ========================= -->
</VBox>

                        <VBox styleClass="erp-card">
<Label text="DISPONIBILIDAD"
                               styleClass="label-section"/>

                        <HBox spacing="10.0">

                            <children>

                                <ComboBox fx:id="cmbDiaSemana"
                                          promptText="Día"
                                          prefWidth="140.0"
                                          styleClass="combo-box"/>

                                <ComboBox fx:id="cmbHoraDesde"
                                          promptText="Desde"
                                          prefWidth="110.0"
                                          styleClass="combo-box"/>

                                <ComboBox fx:id="cmbHoraHasta"
                                          promptText="Hasta"
                                          prefWidth="110.0"
                                          styleClass="combo-box"/>

                                <Button fx:id="btnAgregarDisponibilidad"
                                        text="AGREGAR"
                                        prefWidth="100.0"
                                        styleClass="action-button"
                                        onAction="#agregarDisponibilidad"/>

                            </children>

                        </HBox>


                        <ListView fx:id="lstDisponibilidades"
                                  prefHeight="110.0"
                                  maxHeight="110.0"/>
</VBox>

                        <!-- ========================= -->
                        <!-- BOTONES -->
                        <!-- ========================= -->

                        <HBox spacing="10.0" alignment="CENTER_RIGHT" styleClass="erp-action-bar">

                            <children>

                                <Button fx:id="btnGuardar"
                                        text="GUARDAR PROFESIONAL"
                                        prefWidth="190.0"
                                        styleClass="action-button"
                                        onAction="#guardarProfesional"/>

                                <Button fx:id="btnLimpiar"
                                        text="LIMPIAR"
                                        prefWidth="120.0"
                                        styleClass="action-button erp-neutral"
                                        onAction="#limpiarFormulario"/>

                            </children>

                        </HBox>

                    </children>

                    <padding>
                        <Insets top="15.0"
                                right="20.0"
                                bottom="20.0"
                                left="20.0"/>
                    </padding>

                </VBox>

            </content>

        </ScrollPane>

    </children>

</AnchorPane>