<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.FacturaController"
            styleClass="erp-root"
            stylesheets="@/resource/styles.css">

    <center>
        <VBox styleClass="erp-page">
            <Label text="FACTURA" styleClass="erp-title" />

            <VBox styleClass="erp-card">
                <!-- Datos del cliente -->
                <Label text="Cliente:" styleClass="erp-caption" />
                <Label fx:id="lblCliente" styleClass="label-subsection" />

                <!-- Servicios realizados -->
                <Label text="Servicios realizados:" styleClass="erp-caption" />
                <ListView fx:id="lvServicios" prefHeight="150" />

                <!-- Forma de pago -->
                <Label text="Forma de pago:" styleClass="erp-caption" />
                <ComboBox fx:id="cbFormaPago" prefWidth="240" />

                <!-- Total -->
                <Label text="Total a pagar:" styleClass="erp-caption" />
                <Label fx:id="lblTotal" styleClass="erp-title" />
            </VBox>

            <!-- Botón de confirmación -->
            <HBox alignment="CENTER_RIGHT" styleClass="erp-action-bar">
                <Button fx:id="btnConfirmar"
                        text="Confirmar factura"
                        onAction="#handleConfirmarFactura"
                        prefWidth="200"
                        styleClass="action-button" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
