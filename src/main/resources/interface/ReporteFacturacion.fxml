<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.ReporteFacturacionController"
            styleClass="erp-root"
            stylesheets="@/resource/styles.css"
            prefWidth="1050" prefHeight="700">

    <top>
        <VBox styleClass="erp-page">
            <Label text="REPORTE DE FACTURACIÓN" styleClass="erp-title"/>

            <!-- Período -->
            <VBox styleClass="erp-card">
                <Label text="PERÍODO" styleClass="erp-card-title"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Desde:"/>
                    <DatePicker fx:id="fechaInicio"/>
                    <Label text="Hasta:"/>
                    <DatePicker fx:id="fechaFin"/>
                    <Button fx:id="btnGenerar" text="Generar reporte" onAction="#generarReporte" styleClass="action-button"/>
                </HBox>
            </VBox>

            <!-- Panel de Resumen del Período -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label fx:id="lblTotalPeriodo" text="Total Facturado Período: $0.00" styleClass="erp-kpi" />
                <Label fx:id="lblTotalFacturas" text="Total Facturas: 0" styleClass="erp-kpi" />
                <Label fx:id="lblTotalPagadas" text="Total Pagadas: 0" styleClass="erp-kpi erp-ok" />
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
            <content>
                <VBox spacing="14">
                    <padding>
                        <Insets top="0" right="24" bottom="14" left="24"/>
                    </padding>

                    <Label text="GRÁFICOS" styleClass="erp-card-title"/>

                    <!-- 1. Gráfico de Línea ocupando el ancho completo -->
                    <LineChart fx:id="graficoFacturacion" prefHeight="260" minHeight="220" title="Evolución diaria de facturación ($)">
                        <xAxis>
                            <CategoryAxis label="Fecha"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Total facturado"/>
                        </yAxis>
                    </LineChart>

                    <!-- 2. Distribución lado a lado -->
                    <HBox spacing="14">
                        <children>
                            <!-- Gráfico Apilado (Evolución diaria por método) -->
                            <StackedBarChart fx:id="graficoMetodosPago" prefHeight="280" minHeight="240" prefWidth="550" title="Cantidad de Facturas por Día (Desglosado por Método)" HBox.hgrow="ALWAYS">
                                <xAxis>
                                    <CategoryAxis label="Fecha"/>
                                </xAxis>
                                <yAxis>
                                    <NumberAxis label="Cantidad de facturas"/>
                                </yAxis>
                            </StackedBarChart>

                            <!-- Gráfico de Torta (Total acumulado por método en el período) -->
                            <PieChart fx:id="graficoTortaMetodos" prefHeight="280" minHeight="240" prefWidth="410" title="Distribución de Métodos (Total Período)" HBox.hgrow="NEVER" />
                        </children>
                    </HBox>

                    <VBox styleClass="erp-card" spacing="10">
                        <Label text="Facturación por cliente" styleClass="label-section"/>
                        <BarChart fx:id="graficoFacturacionCliente" prefHeight="280" minHeight="240" title="Facturación por cliente" legendVisible="false">
                            <xAxis><CategoryAxis label="Cliente"/></xAxis>
                            <yAxis><NumberAxis label="Total facturado"/></yAxis>
                        </BarChart>
                    </VBox>

                    <Label text="RESULTADOS" styleClass="erp-card-title"/>

                    <!-- 3. Tabla de facturas del período -->
                    <TableView fx:id="tablaResumen" prefHeight="260" minHeight="200"><columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colCliente" text="Cliente" prefWidth="240"/>
                            <TableColumn fx:id="colFecha" text="Fecha y hora" prefWidth="180"/>
                            <TableColumn fx:id="colMonto" text="Monto" prefWidth="150"/>
                            <TableColumn fx:id="colFormaPago" text="Forma de pago" prefWidth="180"/>
                        </columns>
                    </TableView>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <VBox styleClass="erp-card">
            <BorderPane.margin>
                <Insets top="0" right="24" bottom="20" left="24"/>
            </BorderPane.margin>
            <Label text="EXPORTACIÓN" styleClass="erp-card-title"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="btnExportar" text="Exportar gráficos" onAction="#exportarReporte" styleClass="erp-outline"/>
                <Button fx:id="btnExportarPDF" text="Exportar a PDF" onAction="#exportarReportePDF" styleClass="erp-outline"/>
                <Button fx:id="btnExportarExcel" text="Exportar a Excel" onAction="#exportarReporteExcel" styleClass="erp-outline"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
