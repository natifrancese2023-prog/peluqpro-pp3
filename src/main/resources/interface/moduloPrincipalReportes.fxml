<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:controller="controllers.ModuloPrincipalReportesController"
            styleClass="erp-root"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@/resource/styles.css"
            AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="14.0" prefHeight="76.0"
              AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
              styleClass="erp-module-header">
            <padding>
                <Insets top="10.0" right="24.0" bottom="10.0" left="24.0" />
            </padding>
            <children>
                <VBox alignment="CENTER_LEFT" spacing="2.0">
                    <children>
                        <Label text="PeluqPro" styleClass="label-header" />
                        <Label text="MÓDULO REPORTES" styleClass="erp-subtitle" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <VBox prefWidth="210.0" spacing="10.0" styleClass="erp-sidebar"
              AnchorPane.topAnchor="76.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
            <padding>
                <Insets top="16.0" right="14.0" bottom="16.0" left="14.0" />
            </padding>
            <children>
                <Label text="CONSULTAS Y REPORTES" styleClass="erp-card-title" />

                <Button fx:id="btnReporteCliente" text="REPORTE CLIENTES"
                        prefWidth="180.0" prefHeight="42.0" styleClass="menu-button"
                        onAction="#abrirReporteClientes" />

                <Button fx:id="btnListadoFacturas" text="LISTADO FACTURAS"
                        prefWidth="180.0" prefHeight="42.0" styleClass="menu-button"
                        onAction="#abrirListadoFacturas" />

                <Button fx:id="btnReporteFacturacion" text="REPORTE FACTURACIÓN"
                        prefWidth="180.0" prefHeight="42.0" styleClass="menu-button"
                        onAction="#abrirReporteFacturacion" />

                <Button fx:id="btnProductividad" text="PRODUCTIVIDAD PROFESIONAL"
                        prefWidth="180.0" prefHeight="42.0" styleClass="menu-button"
                        onAction="#cargarSubModulo" userData="/interface/ProductividadProfesional.fxml" />

                <Button fx:id="btnRankingServicios" text="RANKING DE SERVICIOS"
                        prefWidth="180.0" prefHeight="42.0" styleClass="menu-button"
                        onAction="#cargarSubModulo" userData="/interface/RankingServicios.fxml" />

                <Separator prefWidth="180.0" />

                <Button fx:id="btnExportarTodoPower" text="EXPORTAR TODO EXCEL"
                        prefWidth="180.0" prefHeight="42.0" styleClass="erp-outline"
                        onAction="#exportarReporteGeneral" />
            </children>
        </VBox>

        <AnchorPane fx:id="panelContenidoReportes" styleClass="content-panel"
                    AnchorPane.topAnchor="76.0" AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="210.0" AnchorPane.rightAnchor="0.0">
            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
            </padding>
            <children>
                <VBox alignment="CENTER" spacing="8.0"
                      AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                      AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                    <children>
                        <Label text="Módulo de Reportes" styleClass="erp-title" />
                        <Label text="Seleccione una consulta del menú para visualizar sus resultados." styleClass="erp-subtitle" />
                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>
