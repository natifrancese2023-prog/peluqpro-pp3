<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ModuloPrincipalProfesionalController"
            prefHeight="600.0"
            prefWidth="1000.0">

    <children>

        <VBox spacing="15.0"
              AnchorPane.topAnchor="20.0"
              AnchorPane.bottomAnchor="20.0"
              AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0">

            <children>

                <Label text="GESTIÓN DE PROFESIONALES"
                       styleClass="label-header"/>

                <HBox spacing="10.0">

                    <children>

                        <Button fx:id="btnAltaProfesional"
                                mnemonicParsing="false"
                                prefHeight="45.0"
                                prefWidth="180.0"
                                text="ALTA PROFESIONAL"
                                styleClass="menu-button"
                                onAction="#cargarSubModulo"
                                userData="/interface/AltaProfesional.fxml"/>

                        <Button fx:id="btnFichaProfesional"
                                mnemonicParsing="false"
                                prefHeight="45.0"
                                prefWidth="180.0"
                                text="FICHA PROFESIONAL"
                                styleClass="menu-button"
                                onAction="#cargarSubModulo"
                                userData="/interface/FichaProfesional.fxml"/>

                        <Button fx:id="btnListarProfesionales"
                                mnemonicParsing="false"
                                prefHeight="45.0"
                                prefWidth="180.0"
                                text="LISTADO PROFESIONALES"
                                styleClass="menu-button"
                                onAction="#cargarSubModulo"
                                userData="/interface/ListarProfesionales.fxml"/>


                    </children>

                </HBox>

                <AnchorPane fx:id="panelContenidoProfesional"
                            VBox.vgrow="ALWAYS">

                </AnchorPane>

            </children>

            <padding>
                <Insets top="10.0"
                        right="10.0"
                        bottom="10.0"
                        left="10.0"/>
            </padding>

        </VBox>

    </children>

</AnchorPane>