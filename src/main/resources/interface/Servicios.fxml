<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ServiciosController"
            styleClass="erp-root"
            stylesheets="@/resource/styles.css"
            prefWidth="1100.0" prefHeight="700.0">

    <top>
        <VBox spacing="2.0">
            <padding><Insets top="16.0" right="24.0" bottom="12.0" left="24.0"/></padding>
            <Label text="PeluqPro" styleClass="label-header"/>
            <Label text="MÓDULO SERVICIOS" styleClass="erp-subtitle"/>
        </VBox>
    </top>

    <left>
        <VBox prefWidth="210.0" spacing="10.0" styleClass="erp-sidebar">
            <padding><Insets top="16.0" right="14.0" bottom="16.0" left="14.0"/></padding>
            <children>
                <Label text="GESTIÓN DE SERVICIOS" styleClass="erp-card-title"/>
                <Button fx:id="btnGestionarServicios" text="SERVICIOS" prefWidth="180.0" prefHeight="42.0" styleClass="menu-button" onAction="#mostrarGestionServicios"/>
                <Button fx:id="btnGestionarEspecialidades" text="ESPECIALIDADES" prefWidth="180.0" prefHeight="42.0" styleClass="menu-button" onAction="#mostrarGestionEspecialidades"/>
                <Button text="RANKING DE MARGEN" prefWidth="180.0" prefHeight="42.0" styleClass="menu-button" onAction="#verRankingMargen"/>
                <Separator prefWidth="180.0"/>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="14.0">
            <padding>
                <Insets top="6.0" right="24.0" bottom="24.0" left="24.0"/>
            </padding>

            <!-- CONTENEDOR PRINCIPAL -->
            <StackPane fx:id="contenedorVistas"
                       VBox.vgrow="ALWAYS">

                <!-- VISTA INICIAL -->
                <VBox fx:id="vistaInicio"
                      alignment="CENTER"
                      spacing="10.0">

                    <Label text="Seleccione una opción" styleClass="label-subsection"/>

                    <Label text="Seleccione Gestionar Servicios o Gestionar Especialidades" styleClass="erp-subtitle"/>

                </VBox>

                <!-- GESTIONAR SERVICIOS -->
                <VBox fx:id="panelServicios"
                      styleClass="erp-card"
                      spacing="12.0"
                      visible="false"
                      managed="false">

                    <HBox spacing="12.0"
                          alignment="CENTER_LEFT">

                        <Label text="GESTIONAR SERVICIOS" styleClass="erp-section"/>

                        <Label text="Catálogo de servicios" styleClass="erp-subtitle"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <TextField fx:id="txtBuscarServicio"
                                   promptText="Buscar servicio..."
                                   prefWidth="250.0"/>

                    </HBox>

                    <!-- TABLA DE SERVICIOS -->
                    <TableView fx:id="tablaServicios"
                               VBox.vgrow="ALWAYS">

                        <columns>

                            <TableColumn fx:id="colNombreServicio"
                                         text="Servicio"
                                         prefWidth="220.0"/>

                            <TableColumn fx:id="colDescripcionServicio"
                                         text="Descripción"
                                         prefWidth="250.0"/>

                            <TableColumn fx:id="colDuracionServicio"
                                         text="Duración"
                                         prefWidth="100.0"/>

                            <TableColumn fx:id="colPrecioServicio"
                                         text="Precio"
                                         prefWidth="120.0"/>

                            <TableColumn fx:id="colCostoServicio"
                                         text="Costo"
                                         prefWidth="120.0"/>

                            <TableColumn fx:id="colEstadoServicio"
                                         text="Estado"
                                         prefWidth="100.0"/>

                        </columns>

                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>

                    </TableView>

                    <!-- BOTONES -->
                    <HBox spacing="10.0"
                          alignment="CENTER_RIGHT">

                        <Button fx:id="btnNuevoServicio"
                                text="NUEVO SERVICIO"
                                styleClass="action-button"
                                onAction="#nuevoServicio"/>

                        <Button fx:id="btnModificarServicio"
                                text="MODIFICAR"
                                onAction="#modificarServicio"/>

                        <Button fx:id="btnEstadoServicio"
                                text="ACTIVAR / INACTIVAR"
                                onAction="#cambiarEstadoServicio"/>

                    </HBox>

                </VBox>

                <!-- GESTIONAR ESPECIALIDADES -->
                <VBox fx:id="panelEspecialidades"
                      styleClass="erp-card"
                      spacing="12.0"
                      visible="false"
                      managed="false">

                    <HBox spacing="12.0"
                          alignment="CENTER_LEFT">

                        <Label text="GESTIONAR ESPECIALIDADES" styleClass="erp-section"/>

                        <Label text="Especialidades y servicios asociados" styleClass="erp-subtitle"/>

                    </HBox>

                    <!-- CONTENIDO ESPECIALIDADES -->
                    <HBox spacing="16.0"
                          VBox.vgrow="ALWAYS">

                        <!-- LISTA DE ESPECIALIDADES -->
                        <VBox spacing="8.0"
                              prefWidth="350.0">

                            <Label text="ESPECIALIDADES" styleClass="erp-card-title"/>

                            <TextField fx:id="txtBuscarEspecialidad"
                                       promptText="Buscar especialidad..."/>

                            <ListView fx:id="listaEspecialidades"
                                      VBox.vgrow="ALWAYS"/>

                            <HBox spacing="8.0">

                                <Button fx:id="btnNuevaEspecialidad"
                                        text="NUEVA"
                                        styleClass="action-button"
                                        onAction="#nuevaEspecialidad"/>

                                <Button fx:id="btnModificarEspecialidad"
                                        text="MODIFICAR"
                                        onAction="#modificarEspecialidad"/>

                                <Button fx:id="btnEstadoEspecialidad"
                                        text="ACTIVAR / INACTIVAR"
                                        onAction="#cambiarEstadoEspecialidad"/>

                            </HBox>

                        </VBox>

                        <!-- SERVICIOS DE LA ESPECIALIDAD -->
                        <VBox spacing="8.0"
                              HBox.hgrow="ALWAYS">

                            <Label fx:id="lblEspecialidadSeleccionada"
                                   text="SERVICIOS ASOCIADOS"
                                   styleClass="erp-card-title"/>

                            <TableView fx:id="tablaServiciosEspecialidad"
                                       VBox.vgrow="ALWAYS">

                                <columns>

                                    <TableColumn fx:id="colServicioEspecialidad"
                                                 text="Servicio"
                                                 prefWidth="220.0"/>

                                    <TableColumn fx:id="colDuracionEspecialidad"
                                                 text="Duración"
                                                 prefWidth="100.0"/>

                                    <TableColumn fx:id="colPrecioEspecialidad"
                                                 text="Precio"
                                                 prefWidth="120.0"/>

                                    <TableColumn fx:id="colEstadoEspecialidadServicio"
                                                 text="Estado"
                                                 prefWidth="100.0"/>

                                </columns>

                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>

                            </TableView>

                            <!-- BOTONES DE ASOCIACIÓN -->
                            <HBox spacing="10.0"
                                  alignment="CENTER_RIGHT">

                                <Button fx:id="btnAsociarServicio"
                                        text="ASOCIAR SERVICIO"
                                        styleClass="action-button"
                                        onAction="#asociarServicio"/>

                                <Button fx:id="btnDesasociarServicio"
                                        text="DESASOCIAR SERVICIO"
                                        styleClass="danger-button"
                                        onAction="#desasociarServicio"/>

                            </HBox>

                        </VBox>

                    </HBox>

                </VBox>

            </StackPane>

        </VBox>
    </center>

</BorderPane>
