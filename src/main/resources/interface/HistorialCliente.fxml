<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane styleClass="erp-root" prefHeight="550.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.HistorialClienteController"
            stylesheets="@/resource/styles.css"> <children>
    <VBox styleClass="erp-page" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>
            <VBox spacing="4.0">
                <children>
                    <Label text="Historial de Visitas del Cliente" styleClass="label-header" />
                    <Label fx:id="lblNombreCliente" text="Cliente: [Cargando...]" styleClass="label-subsection" />
                </children>
            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="erp-card">
                <children>
                    <Label text="Servicio:" />
                    <ComboBox fx:id="cmbServicio"
                              prefWidth="250.0"
                              promptText="Todos los servicios"
                              onAction="#handleFiltroServicio" />
                </children>
            </HBox>

            <TableView fx:id="tvHistorial" VBox.vgrow="ALWAYS" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colFecha" prefWidth="120.0" text="Fecha Visita" />
                    <TableColumn fx:id="colEstilista" prefWidth="150.0" text="Estilista" />
                    <TableColumn fx:id="colServicio" prefWidth="180.0" text="Servicio Realizado" />
                    <TableColumn fx:id="colObservaciones" prefWidth="300.0" text="Observaciones" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="erp-action-bar">
                <children>
                    <Button fx:id="btnExportar" mnemonicParsing="false" onAction="#handleExportarHistorial" text="EXPORTAR HISTORIAL" styleClass="action-button erp-outline" />
                    <Button fx:id="btnCerrar" mnemonicParsing="false" onAction="#handleCerrarVentana" text="CERRAR VENTANA" styleClass="secondary-button" />
                </children>
            </HBox>
        </children>
    </VBox>
</children>
</AnchorPane>
