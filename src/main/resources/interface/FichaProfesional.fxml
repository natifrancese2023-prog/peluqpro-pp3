<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.FichaProfesionalController"
            styleClass="erp-root"
            stylesheets="@/resource/styles.css"
            prefWidth="1000.0"
            prefHeight="720.0">
    <top>
        <VBox styleClass="erp-page">
            <children>
                <Label text="FICHA DEL PROFESIONAL" styleClass="titulo-principal"/>
                <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="erp-card">
                    <Label text="Tipo de documento:"/>
                    <ComboBox fx:id="cmbTipoDocumento" prefWidth="160.0"/>
                    <Label text="Número:"/>
                    <TextField fx:id="txtDocumento"
                               promptText="Ingrese documento..."
                               prefWidth="220.0"/>
                    <Button text="Buscar"
                            onAction="#buscarProfesional"
                            styleClass="boton-buscar"/>
                </HBox>
            </children>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED">
            <content>
                <VBox spacing="14.0">
                    <padding>
                        <Insets top="0.0" right="24.0" bottom="12.0" left="24.0"/>
                    </padding>
                    <children>
                        <VBox styleClass="erp-card">
                            <Label text="DATOS PERSONALES" styleClass="label-section"/>
                            <GridPane hgap="24.0" vgap="10.0">
                                <columnConstraints><ColumnConstraints minWidth="110.0" prefWidth="140.0"/><ColumnConstraints hgrow="ALWAYS" minWidth="120.0"/><ColumnConstraints minWidth="110.0" prefWidth="140.0"/><ColumnConstraints hgrow="ALWAYS" minWidth="120.0"/></columnConstraints>
                                <children>
                                    <Label text="Nombre" styleClass="erp-field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                    <TextField fx:id="txtNombre" editable="false" focusTraversable="false" styleClass="erp-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                    <Label text="Apellido" styleClass="erp-field-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                                    <TextField fx:id="txtApellido" editable="false" focusTraversable="false" styleClass="erp-value" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                                    <Label text="Teléfono" styleClass="erp-field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                    <TextField fx:id="txtTelefono" editable="false" focusTraversable="false" styleClass="erp-value" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                    <Label text="Email" styleClass="erp-field-label" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                                    <TextField fx:id="txtEmail" editable="false" focusTraversable="false" styleClass="erp-value" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
                                </children>
                            </GridPane>
                        </VBox>
                        <VBox styleClass="erp-card">
                            <Label text="DOMICILIO" styleClass="label-section"/>
                            <GridPane hgap="24.0" vgap="10.0">
                                <columnConstraints><ColumnConstraints minWidth="110.0" prefWidth="140.0"/><ColumnConstraints hgrow="ALWAYS" minWidth="120.0"/><ColumnConstraints minWidth="110.0" prefWidth="140.0"/><ColumnConstraints hgrow="ALWAYS" minWidth="120.0"/></columnConstraints>
                                <children>
                                    <Label text="Provincia" styleClass="erp-field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                    <TextField fx:id="txtProvincia" editable="false" focusTraversable="false" styleClass="erp-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                    <Label text="Ciudad" styleClass="erp-field-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                                    <TextField fx:id="txtCiudad" editable="false" focusTraversable="false" styleClass="erp-value" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                                    <Label text="Barrio" styleClass="erp-field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                    <TextField fx:id="txtBarrio" editable="false" focusTraversable="false" styleClass="erp-value" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                    <Label text="Calle" styleClass="erp-field-label" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                                    <TextField fx:id="txtCalle" editable="false" focusTraversable="false" styleClass="erp-value" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
                                    <Label text="Número" styleClass="erp-field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                    <TextField fx:id="txtNumero" editable="false" focusTraversable="false" styleClass="erp-value" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                                </children>
                            </GridPane>
                        </VBox>
                        <VBox styleClass="erp-card">
                            <Label text="DATOS PROFESIONALES" styleClass="label-section"/>
                            <GridPane hgap="24.0" vgap="10.0">
                                <columnConstraints><ColumnConstraints minWidth="110.0" prefWidth="140.0"/><ColumnConstraints hgrow="ALWAYS" minWidth="120.0"/><ColumnConstraints minWidth="110.0" prefWidth="140.0"/><ColumnConstraints hgrow="ALWAYS" minWidth="120.0"/></columnConstraints>
                                <children>
                                    <Label text="Fecha de ingreso" styleClass="erp-field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                    <TextField fx:id="txtFechaIngreso" editable="false" focusTraversable="false" styleClass="erp-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                    <Label text="Comisión" styleClass="erp-field-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                                    <TextField fx:id="txtComision" editable="false" focusTraversable="false" styleClass="erp-value" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                                    <Label text="Rol" styleClass="erp-field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                    <TextField fx:id="txtRol" editable="false" focusTraversable="false" styleClass="erp-value" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                    <Label text="Estado" styleClass="erp-field-label" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                                    <Label fx:id="lblEstado" text="-" styleClass="erp-field-label" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
                                </children>
                            </GridPane>
                        </VBox>
                        <VBox styleClass="erp-card">
                            <Label text="ESPECIALIDADES" styleClass="label-section"/>
                            <ListView fx:id="lstEspecialidades" prefHeight="55.0" maxHeight="80.0" focusTraversable="false" styleClass="erp-list-plain"/>
                        </VBox>
                        <VBox styleClass="erp-card">
                            <Label text="DISPONIBILIDADES" styleClass="label-section"/>
                            <ListView fx:id="lstDisponibilidades" prefHeight="105.0" maxHeight="130.0" focusTraversable="false" styleClass="erp-list-plain"/>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox spacing="10.0" alignment="CENTER_RIGHT" styleClass="erp-action-bar">
            <padding>
                <Insets top="10.0" right="24.0" bottom="20.0" left="24.0"/>
            </padding>
            <children>
                <Button fx:id="btnModificar" text="Modificar" onAction="#modificarProfesional" styleClass="boton-accion action-button"/>
                <Button fx:id="btnEstado" text="Desactivar" onAction="#cambiarEstado" styleClass="boton-accion"/>
                <Button fx:id="btnComisiones" text="Ver Comisiones" onAction="#verComisiones" styleClass="boton-accion"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>
