<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?> <BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
                                        fx:controller="controllers.ListarClientesController"
                                        styleClass="erp-root"
                                        stylesheets="@/resource/styles.css"
                                        prefHeight="600.0" prefWidth="900.0">

    <top>
        <VBox styleClass="erp-page" BorderPane.alignment="CENTER">
            <children>
                <Label text="Listado Completo de Clientes" styleClass="label-header"/>
            </children>
        </VBox>
    </top>

    <center>
        <VBox spacing="14.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="0.0" right="24.0" bottom="0.0" left="24.0"/>
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="erp-card">
                    <children>
                        <Label text="Estado:"/>
                        <ComboBox fx:id="cmbFiltroEstado" prefWidth="180" />
                    </children>
                </HBox>

                <TableView fx:id="tblClientes" prefHeight="400.0" prefWidth="480.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNombre" prefWidth="120.0" text="Nombre"/>
                        <TableColumn fx:id="colApellido" prefWidth="120.0" text="Apellido"/>
                        <TableColumn fx:id="colDocumento" prefWidth="120.0" text="Documento"/>
                        <TableColumn fx:id="colFechaAlta" prefWidth="100.0" text="Fecha Alta"/>
                        <TableColumn fx:id="colNumeroVisitas" prefWidth="80.0" text="Nº Visitas"/>
                        <TableColumn fx:id="colEstado" prefWidth="80.0" text="Estado"/>
                        <TableColumn fx:id="colAccion" prefWidth="120.0" text="Acceder al Historial"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="erp-action-bar" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="14.0" right="24.0" bottom="20.0" left="24.0"/>
            </padding>
            <children>
                <Button mnemonicParsing="false"
                        onAction="#handleExportarPDF"
                        text="EXPORTAR PDF" styleClass="erp-outline"/>

                <Button mnemonicParsing="false"
                        onAction="#handleExportarExcel"
                        text="EXPORTAR EXCEL" styleClass="erp-outline"/>

                <Button mnemonicParsing="false"
                        onAction="#handleCerrar"
                        text="Cerrar"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>
