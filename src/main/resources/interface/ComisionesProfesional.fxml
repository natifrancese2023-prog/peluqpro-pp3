<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ComisionesProfesionalController"
            prefWidth="1050.0"
            prefHeight="650.0"
            minWidth="950.0"
            minHeight="600.0">

    <top>

        <VBox spacing="8">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="15"
                        left="20"/>
            </padding>

            <Label text="COMISIONES DEL PROFESIONAL"
                   styleClass="titulo"/>
            <Label fx:id="lblProfesional"
                   text="-"
                   styleClass="subtitulo"/>
            <Label text="PORCENTAJE"
                   styleClass="titulo"/>
            <Label fx:id="lblPorcentaje"
                   text="0 %"
                   styleClass="subtitulo"/>


        </VBox>

    </top>


    <center>

        <VBox spacing="15">

            <padding>
                <Insets top="10"
                        right="20"
                        bottom="10"
                        left="20"/>
            </padding>

            <HBox spacing="10"
                  alignment="CENTER_LEFT">

                <Label text="Desde:"/>

                <DatePicker fx:id="dpDesde"/>

                <Label text="Hasta:"/>

                <DatePicker fx:id="dpHasta"/>

                <Button text="CONSULTAR"
                        onAction="#consultarComisiones"
                        styleClass="boton-accion"/>

                <Button text="HOY"
                        onAction="#consultarHoy"/>

                <Button text="ESTE MES"
                        onAction="#consultarMes"/>

            </HBox>


            <TableView fx:id="tablaComisiones"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colFecha"
                                 text="Fecha"
                                 prefWidth="110"/>

                    <TableColumn fx:id="colServicio"
                                 text="Servicio"
                                 prefWidth="250"/>

                    <TableColumn fx:id="colPrecio"
                                 text="Precio"
                                 prefWidth="140"/>

                    <TableColumn fx:id="colComision"
                                 text="Comisión"
                                 prefWidth="140"/>

                </columns>

            </TableView>

        </VBox>

    </center>


    <bottom>

        <HBox spacing="15"
              alignment="CENTER_RIGHT">

            <padding>
                <Insets top="10"
                        right="20"
                        bottom="15"
                        left="20"/>
            </padding>

            <Label text="TOTAL COMISIONES:"
                   styleClass="subtitulo"/>

            <Label fx:id="lblTotal"
                   text="0,00"
                   styleClass="subtitulo"/>

            <Button text="CERRAR"
                    onAction="#cerrar"/>

        </HBox>

    </bottom>

</BorderPane>