<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ComisionesProfesionalController"
            styleClass="erp-root"
            stylesheets="@/resource/styles.css"
            prefWidth="1000.0"
            prefHeight="650.0"
            minWidth="800.0"
            minHeight="520.0">

    <top>

        <VBox styleClass="erp-page">
            <Label text="COMISIONES DEL PROFESIONAL"
                   styleClass="titulo erp-title"/>
            <HBox spacing="48" alignment="CENTER_LEFT" styleClass="erp-card">
                <Label fx:id="lblProfesional"
                       text="-"
                       styleClass="subtitulo label-subsection"/>
                <VBox spacing="2">
                    <Label text="PORCENTAJE"
                           styleClass="titulo erp-caption"/>
                    <Label fx:id="lblPorcentaje"
                           text="0 %"
                           styleClass="subtitulo label-subsection"/>
                </VBox>
            </HBox>
        </VBox>

    </top>


    <center>

        <VBox spacing="14">
            <padding>
                <Insets top="0" right="24" bottom="10" left="24"/>
            </padding>
            <VBox styleClass="erp-card">
                <Label text="PERÍODO" styleClass="erp-card-title"/>
                <HBox spacing="10"
                  alignment="CENTER_LEFT">

                <Label text="Desde:"/>

                <DatePicker fx:id="dpDesde"/>

                <Label text="Hasta:"/>

                <DatePicker fx:id="dpHasta"/>

                <Button text="CONSULTAR"
                        onAction="#consultarComisiones"
                        styleClass="boton-accion action-button"/>

                <Button text="HOY"
                        onAction="#consultarHoy"/>

                <Button text="ESTE MES"
                        onAction="#consultarMes"/>

            </HBox>
            </VBox>


            <TableView fx:id="tablaComisiones"
                       VBox.vgrow="ALWAYS">
<columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>

                <columns>

                    <TableColumn fx:id="colFecha"
                                 text="Fecha"
                                 prefWidth="110"/>

                    <TableColumn fx:id="colServicio"
                                 text="Servicio"
                                 prefWidth="250"/>

                    <TableColumn fx:id="colPrecio"
                                 text="Precio"
                                 prefWidth="140"/>

                    <TableColumn fx:id="colComision"
                                 text="Comisión"
                                 prefWidth="140"/>

                </columns>

            </TableView>

        </VBox>

    </center>


    <bottom>

        <HBox spacing="12"
              alignment="CENTER_RIGHT"
              styleClass="erp-action-bar">
            <padding>
                <Insets top="10"
                        right="24"
                        bottom="20"
                        left="24"/>
            </padding>

            <Label text="TOTAL COMISIONES:"
                   styleClass="subtitulo label-subsection"/>

            <Label fx:id="lblTotal"
                   text="0,00"
                   styleClass="subtitulo label-subsection"/>

            <Button text="CERRAR"
                    onAction="#cerrar"/>

        </HBox>

    </bottom>

</BorderPane>