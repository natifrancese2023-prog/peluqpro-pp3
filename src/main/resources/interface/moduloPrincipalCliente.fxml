<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<!-- Quitamos las medidas fijas prefHeight/prefWidth del AnchorPane principal -->
<!-- para que sea el contenedor padre quien decida su tamaño real -->
<AnchorPane fx:controller="controllers.ModuloClienteController" styleClass="erp-root"
            xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@/resource/styles.css"
            AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
    <children>
        <!-- Encabezado del módulo -->
        <AnchorPane prefHeight="76.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="14.0" prefHeight="76.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                    <children>
                        <ImageView fitHeight="56.0" fitWidth="90.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@747e63d5-c24e-4b1e-8622-61cde71cd610.png" />
                            </image>
                        </ImageView>
                        <VBox alignment="CENTER_LEFT" spacing="2.0">
                            <children>
                                <Label text="PeluqPro" styleClass="label-header" />
                                <Label text="MODULO CLIENTES" styleClass="erp-subtitle" />
                            </children>
                        </VBox>
                    </children>
                    <padding>
                        <Insets top="10.0" right="24.0" bottom="10.0" left="24.0" />
                    </padding>
                </HBox>
            </children>
        </AnchorPane>

        <!-- Menú lateral -->
        <VBox prefWidth="200.0" spacing="10.0" styleClass="erp-sidebar"
              AnchorPane.topAnchor="76.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
            <children>
                <Label text="Seleccione una opción." styleClass="erp-card-title" />

                <Button fx:id="btnAltaCliente" text="ALTA" prefWidth="170.0" prefHeight="45.0" styleClass="menu-button"
                        onAction="#cargarSubModulo" userData="/interface/AltaCliente.fxml" />

                <Button fx:id="btnFicha" text="FICHA CLIENTE" prefWidth="170.0" prefHeight="45.0" styleClass="menu-button"
                        onAction="#cargarSubModulo" userData="/interface/FichaCliente.fxml" />

                <Button fx:id="btnListar" text="LISTADO CLIENTE" prefWidth="170.0" prefHeight="45.0" styleClass="menu-button"
                        onAction="#cargarSubModulo" userData="/interface/ListarClientes.fxml" />

                <Separator prefWidth="170.0" />
            </children>
        </VBox>

        <!-- Panel de contenido (ocupa todo el espacio restante) -->
        <AnchorPane fx:id="panelContenidoCliente"
                    AnchorPane.topAnchor="76.0" AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="200.0" AnchorPane.rightAnchor="0.0">
            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
            </padding>
            <children>
                <Label text="Bienvenido al Módulo de Clientes." styleClass="label-subsection" AnchorPane.topAnchor="20.0" AnchorPane.leftAnchor="20.0" />
            </children>
        </AnchorPane>
    </children>
</AnchorPane>
