<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane styleClass="erp-root" prefHeight="800.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.ModificarClienteController"
            stylesheets="@/resource/styles.css">
    <children>
        <VBox styleClass="erp-page"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Label text="MODIFICAR DATOS DEL CLIENTE" styleClass="label-header" />

                <VBox fx:id="vboxDatosCliente" styleClass="erp-card">
                    <children>
                        <Label text="Datos del Cliente a Modificar" styleClass="label-section" />

                        <GridPane hgap="15.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints minWidth="90.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="160.0" prefWidth="300.0" />
                                <ColumnConstraints minWidth="90.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="160.0" prefWidth="300.0" />
                            </columnConstraints>
                            <children>
                                <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="1" editable="true" styleClass="text-field" />

                                <Label text="Apellido:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                                <TextField fx:id="txtApellido" GridPane.rowIndex="0" GridPane.columnIndex="3" editable="true" styleClass="text-field" />

                                <Label text="Teléfono:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="txtTelefono" GridPane.rowIndex="1" GridPane.columnIndex="1" editable="true" styleClass="text-field" />

                                <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                                <TextField fx:id="txtEmail" GridPane.rowIndex="1" GridPane.columnIndex="3" editable="true" styleClass="text-field" />

                                <Label text="Calle:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <TextField fx:id="txtCalle" GridPane.rowIndex="2" GridPane.columnIndex="1" editable="true" styleClass="text-field" />

                                <Label text="Número:" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                                <TextField fx:id="txtNumero" GridPane.rowIndex="2" GridPane.columnIndex="3" editable="true" styleClass="text-field" />

                                <Label text="Provincia:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                <ComboBox fx:id="cmbProvincia" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="300.0" maxWidth="1.7976931348623157E308" promptText="Provincia" styleClass="combo-box" />

                                <Label text="Ciudad:" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
                                <ComboBox fx:id="cmbCiudad" GridPane.rowIndex="3" GridPane.columnIndex="3" prefWidth="300.0" maxWidth="1.7976931348623157E308" promptText="Ciudad" styleClass="combo-box" />

                                <Label text="Barrio:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                                <ComboBox fx:id="cmbBarrio" GridPane.rowIndex="4" GridPane.columnIndex="1" prefWidth="300.0" maxWidth="1.7976931348623157E308" promptText="Barrio" styleClass="combo-box" />

                                <Label text="Red Social:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                                <HBox GridPane.rowIndex="5" GridPane.columnIndex="1" spacing="10.0">
                                    <children>
                                        <ComboBox fx:id="cmbTipoRedSocial" prefWidth="130.0" promptText="Tipo Red" styleClass="combo-box" />
                                        <TextField fx:id="txtUsuarioRedSocial" promptText="Usuario" prefWidth="160.0" HBox.hgrow="ALWAYS" editable="true" styleClass="text-field" />
                                    </children>
                                </HBox>
                            </children>
                        </GridPane>
                    </children>
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button fx:id="btnGuardarCambios" text="GUARDAR CAMBIOS"
                                onAction="#handleGuardarCambios"
                                styleClass="action-button" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
