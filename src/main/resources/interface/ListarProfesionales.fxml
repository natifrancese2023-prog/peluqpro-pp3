<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ListarProfesionalesController"
            styleClass="erp-root"
            stylesheets="@/resource/styles.css"
            prefHeight="550.0"
            prefWidth="850.0">
    <!-- TÍTULO -->
    <top>
        <VBox styleClass="erp-page"
              BorderPane.alignment="CENTER">
            <children>
                <Label text="Listado de Profesionales" styleClass="label-header"/>
            </children>
        </VBox>
    </top>
    <!-- TABLA -->
    <center>
        <VBox spacing="14.0"
              BorderPane.alignment="CENTER">
            <padding>
                <Insets top="0.0" right="24.0" bottom="0.0" left="24.0"/>
            </padding>
            <children>
                <!-- FILTRO -->
                <HBox alignment="CENTER_LEFT"
                      spacing="10.0"
                      styleClass="erp-card">
                    <Label text="Estado:"/>
                    <ComboBox fx:id="cmbFiltroEstado"
                              prefWidth="180.0"
                              promptText="Estado"/>
                </HBox>
                <TableView fx:id="tblProfesionales"
                           prefHeight="400.0"
                           prefWidth="800.0"
                           VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNombre"
                                     prefWidth="130.0"
                                     text="Nombre"/>
                        <TableColumn fx:id="colApellido"
                                     prefWidth="130.0"
                                     text="Apellido"/>
                        <TableColumn fx:id="colDocumento"
                                     prefWidth="130.0"
                                     text="Documento"/>
                        <TableColumn fx:id="colFechaIngreso"
                                     prefWidth="120.0"
                                     text="Fecha Ingreso"/>
                        <TableColumn fx:id="colComision"
                                     prefWidth="100.0"
                                     text="Comisión"/>
                        <TableColumn fx:id="colEstado"
                                     prefWidth="100.0"
                                     text="Estado"/>
                        <TableColumn fx:id="colAccion"
                                     prefWidth="180.0"
                                     text="Acciones"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>
    <!-- BOTÓN CERRAR -->
    <bottom>
        <HBox alignment="CENTER_RIGHT"
              spacing="10.0"
              styleClass="erp-action-bar"
              BorderPane.alignment="CENTER">
            <padding>
                <Insets top="14.0" right="24.0" bottom="20.0" left="24.0"/>
            </padding>
            <children>
                <Button mnemonicParsing="false"
                        onAction="#handleCerrar"
                        text="Cerrar"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>
