<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.geometry.Insets?>
        <?import javafx.scene.control.*?>
        <?import javafx.scene.layout.*?>
        <?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ListarProfesionalesController"
            prefHeight="550.0"
            prefWidth="850.0">

    <!-- TÍTULO -->
    <top>
        <VBox alignment="TOP_CENTER"
              BorderPane.alignment="CENTER">

            <children>

                <Label text="Listado de Profesionales">

                    <font>
                        <Font name="System Bold" size="24.0"/>
                    </font>

                    <VBox.margin>
                        <Insets bottom="10.0"
                                top="20.0"/>
                    </VBox.margin>

                </Label>

            </children>

        </VBox>
    </top>


    <!-- TABLA -->
    <center>

        <VBox spacing="10.0"
              alignment="TOP_CENTER"
              BorderPane.alignment="CENTER">

            <children>

                <!-- FILTRO -->
                <HBox alignment="CENTER_LEFT"
                      spacing="10.0">

                    <Label text="Estado:"/>

                    <ComboBox fx:id="cmbFiltroEstado"
                              prefWidth="150.0"
                              promptText="Estado"/>

                </HBox>


                <TableView fx:id="tblProfesionales"
                           prefHeight="400.0"
                           prefWidth="800.0">

                    <columns>

                        <TableColumn fx:id="colNombre"
                                     prefWidth="130.0"
                                     text="Nombre"/>

                        <TableColumn fx:id="colApellido"
                                     prefWidth="130.0"
                                     text="Apellido"/>

                        <TableColumn fx:id="colDocumento"
                                     prefWidth="130.0"
                                     text="Documento"/>

                        <TableColumn fx:id="colFechaIngreso"
                                     prefWidth="120.0"
                                     text="Fecha Ingreso"/>

                        <TableColumn fx:id="colComision"
                                     prefWidth="100.0"
                                     text="Comisión"/>

                        <TableColumn fx:id="colEstado"
                                     prefWidth="100.0"
                                     text="Estado"/>

                        <TableColumn fx:id="colAccion"
                                     prefWidth="180.0"
                                     text="Acciones"/>

                    </columns>

                    <VBox.margin>
                        <Insets left="20.0"
                                right="20.0"/>
                    </VBox.margin>

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>

                </TableView>

            </children>

        </VBox>

    </center>


    <!-- BOTÓN CERRAR -->
    <bottom>

        <HBox alignment="CENTER"
              spacing="15.0"
              BorderPane.alignment="CENTER">

            <children>

                <Button mnemonicParsing="false"
                        onAction="#handleCerrar"
                        text="Cerrar"/>

            </children>

        </HBox>

    </bottom>

</BorderPane>

