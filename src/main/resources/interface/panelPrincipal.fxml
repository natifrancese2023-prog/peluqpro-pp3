<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="rootPane" prefHeight="800.0" prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.PanelPrincipalController"
            stylesheets="@/resource/styles.css">
    <children>
        <!-- Encabezado (Anclado arriba, izquierda y derecha) -->
        <AnchorPane prefHeight="100.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER" prefHeight="100.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                    <ImageView fitHeight="86.0" fitWidth="140.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@747e63d5-c24e-4b1e-8622-61cde71cd610.png" />
                        </image>
                    </ImageView>

                    <VBox prefHeight="94.0" prefWidth="434.0">
                        <children>
                            <Label text="PeluqPro" styleClass="label-header">
                                <font>
                                    <Font name="Candara" size="41.0" />
                                </font>
                            </Label>
                            <Label text="Sistema de Gestión" />
                        </children>
                    </VBox>

                    <VBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0">
                        <HBox.margin>
                            <Insets top="0" right="50" bottom="0" left="10"/>
                        </HBox.margin>
                        <children>
                            <Label fx:id="lblUsuario" text="👤 [Nombre]" style="-fx-font-size: 15px; -fx-font-weight: bold;" />
                        </children>
                    </VBox>

                    <Button fx:id="btnCerrarSesion" alignment="CENTER" contentDisplay="CENTER"
                            mnemonicParsing="false" prefHeight="40.0" prefWidth="130.0"
                            styleClass="danger-button" text="CERRAR SESIÓN"
                            onAction="#cerrarSesion" />
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </HBox>
            </children>
        </AnchorPane>

        <!-- Menú lateral izquierdo (Anclado a la izquierda, auto-estirable de arriba a abajo) -->
        <VBox prefWidth="200.0" spacing="10.0" styleClass="menu-panel"
              AnchorPane.topAnchor="100.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
            <children>
                <Label styleClass="menu-title" text="Gestiones del Sistema" />

                <Button fx:id="btnGestionClientes" mnemonicParsing="false" prefHeight="45.0" prefWidth="170.0" styleClass="menu-button" text="CLIENTES" onAction="#abrirModuloClientes" />
                <Button fx:id="btnGestionTurnos" mnemonicParsing="false" prefHeight="45.0" prefWidth="170.0" styleClass="menu-button" text="TURNO" onAction="#abrirModuloTurnos" />
                <Button fx:id="btnReporteCliente" mnemonicParsing="false" prefHeight="45.0" prefWidth="170.0" styleClass="menu-button" text="REPORTE CLIENTES"  onAction="#abrirReporteClientes" />
                <Button fx:id="btnListadoFacturas" mnemonicParsing="false" prefHeight="45.0" prefWidth="170.0" styleClass="menu-button" text="LISTADO FACTURAS" onAction="#abrirListadoFacturas" />
                <Button fx:id="btnReporteFacturacion" mnemonicParsing="false" prefHeight="45.0" prefWidth="170.0" styleClass="menu-button" text="REPORTE FACTURACIÓN" onAction="#abrirReporteFacturacion" />
                <Button fx:id="btnExportarTodoPower" prefHeight="45.0" prefWidth="170.0" styleClass="menu-button" text="EXPORTAR TODO EXCEL" onAction="#exportarReporteGeneral"/>
                <Button fx:id="btnGestionProfesionales"
                        mnemonicParsing="false"
                        prefHeight="45.0"
                        prefWidth="170.0"
                        styleClass="menu-button"
                        text="PROFESIONALES"
                        onAction="#abrirModuloProfesionales" />
                <Button fx:id="btnEspecialidades"
                        mnemonicParsing="false"
                        prefHeight="45.0"
                        prefWidth="170.0"
                        styleClass="menu-button"
                        text="SERVICIOS"
                        onAction="#abrirModuloServicios"/>
                <Button fx:id="btnGestionStock" mnemonicParsing="false" prefHeight="45.0" prefWidth="170.0" styleClass="menu-button" text="PRODUCTOS Y STOCK" onAction="#abrirModuloStock" />

            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>

        <!-- Contenedor central principal (Corregido con anclaje total dinámico) -->
        <AnchorPane fx:id="apContenidoPrincipal" styleClass="content-panel"
                    AnchorPane.topAnchor="100.0" AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="200.0" AnchorPane.rightAnchor="0.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <Label text="Bienvenido/a al Sistema de Gestión PeluqPro." AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="10.0">
                    <font><Font size="18.0" /></font>
                </Label>
                <Label text="Utilice el menú lateral para acceder a las diferentes funcionalidades del negocio." AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="35.0" />
            </children>
        </AnchorPane>
    </children>
</AnchorPane>