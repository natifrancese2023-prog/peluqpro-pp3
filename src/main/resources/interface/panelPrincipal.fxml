<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="rootPane" prefHeight="800.0" prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.PanelPrincipalController"
            styleClass="erp-root erp-main-shell"
            stylesheets="@/resource/styles.css">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="14.0" prefHeight="76.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"
              styleClass="erp-main-header">
            <padding>
                <Insets top="10.0" right="24.0" bottom="10.0" left="24.0" />
            </padding>
            <children>
                <ImageView fitHeight="56.0" fitWidth="90.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@747e63d5-c24e-4b1e-8622-61cde71cd610.png" />
                    </image>
                </ImageView>
                <VBox alignment="CENTER_LEFT" spacing="2.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="PeluqPro" styleClass="label-header" />
                        <Label text="Sistema de Gestión" styleClass="erp-subtitle" />
                    </children>
                </VBox>
                <Label fx:id="lblUsuario" text="Bienvenido" styleClass="erp-user-label" />
                <Button fx:id="btnCerrarSesion" text="CERRAR SESIÓN"
                        prefHeight="36.0" prefWidth="130.0" styleClass="danger-button"
                        onAction="#cerrarSesion" />
            </children>
        </HBox>

        <VBox prefWidth="210.0" spacing="10.0" styleClass="erp-sidebar erp-main-sidebar"
              AnchorPane.topAnchor="76.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
            <padding>
                <Insets top="16.0" right="14.0" bottom="16.0" left="14.0" />
            </padding>
            <children>
                <Label text="GESTIONES DEL SISTEMA" styleClass="erp-card-title" />

                <Button fx:id="btnGestionClientes" text="CLIENTES" prefHeight="42.0" prefWidth="180.0" styleClass="menu-button" onAction="#abrirModuloClientes" />
                <Button fx:id="btnGestionTurnos" text="TURNOS" prefHeight="42.0" prefWidth="180.0" styleClass="menu-button" onAction="#abrirModuloTurnos" />
                <Button fx:id="btnReporteCliente" text="REPORTES" prefHeight="42.0" prefWidth="180.0" styleClass="menu-button" onAction="#abrirReporteClientes" />
                <Button fx:id="btnGestionProfesionales" text="PROFESIONALES" prefHeight="42.0" prefWidth="180.0" styleClass="menu-button" onAction="#abrirModuloProfesionales" />
                <Button fx:id="btnEspecialidades" text="SERVICIOS" prefHeight="42.0" prefWidth="180.0" styleClass="menu-button" onAction="#abrirModuloServicios" />
                <Button fx:id="btnGestionStock" text="PRODUCTOS Y STOCK" prefHeight="42.0" prefWidth="180.0" styleClass="menu-button" onAction="#abrirModuloStock" />
            </children>
        </VBox>

        <AnchorPane fx:id="apContenidoPrincipal" styleClass="content-panel"
                    AnchorPane.topAnchor="76.0" AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="210.0" AnchorPane.rightAnchor="0.0">
            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
            </padding>
            <children>
                <VBox alignment="CENTER" spacing="8.0"
                      AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                      AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                    <children>
                        <Label text="Bienvenido/a a PeluqPro" styleClass="erp-title" />
                        <Label text="Seleccione una gestión del menú para comenzar." styleClass="erp-subtitle" />
                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>
