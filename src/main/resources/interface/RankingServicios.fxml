<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.RankingServiciosController"
            prefWidth="1180.0"
            prefHeight="760.0"
            minWidth="1050.0"
            minHeight="650.0">

    <top>
        <VBox spacing="10.0">
            <padding>
                <Insets top="20.0" right="25.0" bottom="15.0" left="25.0"/>
            </padding>

            <Label text="RANKING DE SERVICIOS POR MARGEN ESTIMADO"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <Label text="El cálculo utiliza los servicios realmente realizados en el período seleccionado. La comisión corresponde al profesional que realizó cada servicio."
                   wrapText="true"
                   style="-fx-font-size: 14px; -fx-text-fill: #666666;"/>

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="Desde:"/>
                <DatePicker fx:id="dpDesde" prefWidth="140.0"/>

                <Label text="Hasta:"/>
                <DatePicker fx:id="dpHasta" prefWidth="140.0"/>

                <Button text="HOY" onAction="#consultarHoy"/>
                <Button text="MES ACTUAL" onAction="#consultarMes"/>
                <Button fx:id="btnConsultar" text="CONSULTAR" onAction="#consultar"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10.0">
            <padding>
                <Insets top="5.0" right="25.0" bottom="10.0" left="25.0"/>
            </padding>

            <TableView fx:id="tablaRanking" prefHeight="300.0" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colPosicion" text="#" prefWidth="45.0"/>
                    <TableColumn fx:id="colServicio" text="Servicio" prefWidth="210.0"/>
                    <TableColumn fx:id="colRealizados" text="Realizados" prefWidth="90.0"/>
                    <TableColumn fx:id="colIngresos" text="Ingresos" prefWidth="115.0"/>
                    <TableColumn fx:id="colCosto" text="Costo estimado" prefWidth="125.0"/>
                    <TableColumn fx:id="colComision" text="Comisiones" prefWidth="115.0"/>
                    <TableColumn fx:id="colMargen" text="Margen estimado" prefWidth="135.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <Label fx:id="lblResumen"
                   text=""
                   style="-fx-font-weight: bold; -fx-text-fill: #555555;"/>

            <Label fx:id="lblServicioSeleccionado"
                   text="Seleccione un servicio para ver el detalle por profesional"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <TableView fx:id="tablaDetalle" prefHeight="180.0" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colProfesional" text="Profesional" prefWidth="180.0"/>
                    <TableColumn fx:id="colCantidadDetalle" text="Cantidad" prefWidth="80.0"/>
                    <TableColumn fx:id="colPorcentaje" text="Comisión %" prefWidth="95.0"/>
                    <TableColumn fx:id="colIngresosDetalle" text="Ingresos" prefWidth="110.0"/>
                    <TableColumn fx:id="colCostoDetalle" text="Costo" prefWidth="110.0"/>
                    <TableColumn fx:id="colComisionDetalle" text="Comisión" prefWidth="110.0"/>
                    <TableColumn fx:id="colMargenDetalle" text="Margen generado" prefWidth="125.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10.0" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10.0" right="25.0" bottom="20.0" left="25.0"/>
            </padding>
            <Button text="CERRAR" onAction="#cerrar"/>
        </HBox>
    </bottom>

</BorderPane>
