<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ReporteClienteController"
            styleClass="erp-root"
            stylesheets="@/resource/styles.css">

    <top>
        <VBox styleClass="erp-page">
            <Label text="Reportes de Clientes" styleClass="erp-title"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false">
            <content>
                <VBox spacing="14">
                    <padding>
                        <Insets top="0" right="24" bottom="20" left="24"/>
                    </padding>

                    <!-- ===================================================== -->
                    <!-- TABS INTERNOS DEL REPORTE DE CLIENTES                -->
                    <!-- ===================================================== -->
                    <TabPane tabClosingPolicy="UNAVAILABLE">
                        <tabs>

                            <!-- TAB 1: REPORTE POR CLIENTE -->
                            <Tab text="Reporte por Cliente">
                                <content>
                                    <VBox spacing="14">

                                        <VBox styleClass="erp-card">
                                            <Label text="FILTROS" styleClass="erp-card-title"/>
                                            <GridPane hgap="10" vgap="10">
                                                <Label text="Cliente:"
                                                       GridPane.columnIndex="0"
                                                       GridPane.rowIndex="0"/>

                                                <ComboBox fx:id="cbCliente"
                                                          prefWidth="250"
                                                          GridPane.columnIndex="1"
                                                          GridPane.rowIndex="0"/>

                                                <Label text="Desde:"
                                                       GridPane.columnIndex="2"
                                                       GridPane.rowIndex="0"/>

                                                <DatePicker fx:id="fechaDesdeCliente"
                                                            GridPane.columnIndex="3"
                                                            GridPane.rowIndex="0"/>

                                                <Label text="Hasta:"
                                                       GridPane.columnIndex="4"
                                                       GridPane.rowIndex="0"/>

                                                <DatePicker fx:id="fechaHastaCliente"
                                                            GridPane.columnIndex="5"
                                                            GridPane.rowIndex="0"/>

                                                <Button fx:id="btnConsultarCliente"
                                                        text="Consultar"
                                                        onAction="#consultarCliente"
                                                        GridPane.columnIndex="6"
                                                        GridPane.rowIndex="0"/>
                                            </GridPane>
                                        </VBox>

                                        <Label fx:id="lblTicketPromedio"
                                               text="Ticket promedio: Sin datos"
                                               maxWidth="-Infinity"
                                               styleClass="erp-kpi"/>

                                        <VBox styleClass="erp-card" spacing="10">
                                            <Label text="Historial de servicios del cliente"
                                                   styleClass="label-section"/>

                                            <TableView fx:id="tablaServiciosCliente"
                                                       prefHeight="300"
                                                       minHeight="220">
                                                <columnResizePolicy>
                                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                                </columnResizePolicy>
                                                <columns>
                                                    <TableColumn fx:id="colFechaServicio"
                                                                 text="Fecha"
                                                                 prefWidth="150"/>
                                                    <TableColumn fx:id="colServicioCliente"
                                                                 text="Servicio"
                                                                 prefWidth="180"/>
                                                    <TableColumn fx:id="colEstilistaCliente"
                                                                 text="Estilista"
                                                                 prefWidth="180"/>
                                                    <TableColumn fx:id="colObservacionesCliente"
                                                                 text="Observaciones"
                                                                 prefWidth="250"/>
                                                </columns>
                                            </TableView>
                                        </VBox>
                                    </VBox>
                                </content>
                            </Tab>

                            <!-- TAB 2: CLIENTES EN RIESGO -->
                            <Tab text="Clientes en riesgo">
                                <content>
                                    <VBox styleClass="erp-card" spacing="10">
                                        <Label text="Clientes en riesgo"
                                               styleClass="label-section"/>
                                        <Label text="Clientes que no registran una visita en los últimos tres meses."
                                               styleClass="label-hint"/>

                                        <TableView fx:id="tablaClientesRiesgo"
                                                   prefHeight="300"
                                                   minHeight="220">
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                            </columnResizePolicy>
                                            <columns>
                                                <TableColumn fx:id="colRiesgoNombre"
                                                             text="Cliente"
                                                             prefWidth="220"/>
                                                <TableColumn fx:id="colRiesgoTelefono"
                                                             text="Teléfono"
                                                             prefWidth="140"/>
                                                <TableColumn fx:id="colRiesgoEmail"
                                                             text="Email"
                                                             prefWidth="220"/>
                                                <TableColumn fx:id="colRiesgoUltimaVisita"
                                                             text="Última visita"
                                                             prefWidth="160"/>
                                                <TableColumn fx:id="colRiesgoDias"
                                                             text="Días sin visitar"
                                                             prefWidth="140"/>
                                            </columns>
                                        </TableView>
                                    </VBox>
                                </content>
                            </Tab>

                            <!-- TAB 3: REPORTE GENERAL DE CLIENTES -->
                            <Tab text="Reporte general de clientes">
                                <content>
                                    <VBox spacing="14">

                                        <VBox styleClass="erp-card">
                                            <HBox spacing="10" alignment="CENTER_LEFT">
                                                <Label text="Filtro de clientes:"
                                                       styleClass="erp-field-label"/>
                                                <ComboBox fx:id="cbFiltro"
                                                          prefWidth="200"/>
                                            </HBox>
                                        </VBox>

                                        <VBox styleClass="erp-card">
                                            <Label text="Reporte general de clientes"
                                                   styleClass="label-section"/>

                                            <TableView fx:id="tablaClientes"
                                                       prefHeight="300"
                                                       minHeight="250">
                                                <columnResizePolicy>
                                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                                </columnResizePolicy>
                                                <columns>
                                                    <TableColumn fx:id="colNombre"
                                                                 text="Nombre completo"
                                                                 prefWidth="180"/>
                                                    <TableColumn fx:id="colTelefono"
                                                                 text="Teléfono"
                                                                 prefWidth="130"/>
                                                    <TableColumn fx:id="colEmail"
                                                                 text="Email"
                                                                 prefWidth="200"/>
                                                    <TableColumn fx:id="colVisitas"
                                                                 text="Visitas"
                                                                 prefWidth="90"/>
                                                    <TableColumn fx:id="colGasto"
                                                                 text="Gasto total"
                                                                 prefWidth="120"/>
                                                    <TableColumn fx:id="colEstadoTurno"
                                                                 text="Estado último turno"
                                                                 prefWidth="160"/>
                                                </columns>
                                            </TableView>
                                        </VBox>

                                        <VBox styleClass="erp-card">
                                            <Label text="GRÁFICOS" styleClass="erp-card-title"/>

                                            <Label text="Gasto total por cliente"
                                                   styleClass="label-section"/>
                                            <BarChart fx:id="graficoBarras"
                                                      prefHeight="350"
                                                      minHeight="300"
                                                      legendVisible="false">
                                                <xAxis>
                                                    <CategoryAxis label="Cliente"/>
                                                </xAxis>
                                                <yAxis>
                                                    <NumberAxis label="Gasto total"/>
                                                </yAxis>
                                            </BarChart>

                                            <Label text="Distribución de ingresos"
                                                   styleClass="label-section"/>
                                            <PieChart fx:id="graficoTorta"
                                                      prefHeight="350"
                                                      minHeight="300"/>

                                            <Label text="Frecuencia de visitas por cliente"
                                                   styleClass="label-section"/>
                                            <BarChart fx:id="graficoHistograma"
                                                      prefHeight="350"
                                                      minHeight="300"
                                                      legendVisible="false">
                                                <xAxis>
                                                    <CategoryAxis label="Cliente"/>
                                                </xAxis>
                                                <yAxis>
                                                    <NumberAxis label="Visitas"/>
                                                </yAxis>
                                            </BarChart>
                                        </VBox>
                                    </VBox>
                                </content>
                            </Tab>

                        </tabs>
                    </TabPane>

                    <!-- EXPORTACIÓN GENERAL: FUERA DEL TABPANE -->
                    <VBox styleClass="erp-card">
                        <Label text="EXPORTACIÓN" styleClass="erp-card-title"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button text="Exportar a PDF"
                                    styleClass="erp-outline"
                                    onAction="#exportarPDF"/>
                            <Button text="Exportar a Excel"
                                    styleClass="erp-outline"
                                    onAction="#exportarExcel"/>
                        </HBox>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
