<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.scene.control.*?>
        <?import javafx.scene.layout.*?>
        <?import javafx.geometry.Insets?>

<ScrollPane fitToHeight="true"
            fitToWidth="true"
            stylesheets="@/resource/styles.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AltaTurnoController">

    <content>

        <AnchorPane prefHeight="800.0" prefWidth="950.0">

            <children>

                <VBox spacing="20.0"
                      AnchorPane.topAnchor="0.0"
                      AnchorPane.bottomAnchor="0.0"
                      AnchorPane.leftAnchor="0.0"
                      AnchorPane.rightAnchor="0.0">

                    <padding>
                        <Insets top="20.0"
                                right="20.0"
                                bottom="20.0"
                                left="20.0"/>
                    </padding>

                    <!-- TÍTULO -->
                    <Label text="Registro de Nuevo Turno"
                           styleClass="label-header"/>


                    <!-- ================================================= -->
                    <!-- 1. IDENTIFICACIÓN DEL CLIENTE -->
                    <!-- ================================================= -->

                    <GridPane hgap="15.0"
                              vgap="12.0">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="30.0"/>
                            <ColumnConstraints percentWidth="35.0"/>
                            <ColumnConstraints percentWidth="35.0"/>
                        </columnConstraints>

                        <Label text="1. Identificación del Cliente"
                               GridPane.columnSpan="3"
                               styleClass="label-section"/>

                        <ComboBox fx:id="cbTipoDocumento"
                                  promptText="Tipo Doc."
                                  GridPane.rowIndex="1"
                                  styleClass="combo-box"/>

                        <TextField fx:id="txtDocumento"
                                   promptText="Número de Documento"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="1"
                                   styleClass="text-field"/>

                        <Button fx:id="btnBuscarCliente"
                                text="🔍 Buscar Cliente"
                                onAction="#handleBuscarCliente"
                                GridPane.columnIndex="2"
                                GridPane.rowIndex="1"
                                styleClass="action-button"/>

                        <Label fx:id="lblNombreCliente"
                               text="Cliente Seleccionado: N/A"
                               GridPane.columnSpan="3"
                               GridPane.rowIndex="2"
                               styleClass="label-note"/>

                    </GridPane>


                    <Separator/>


                    <!-- ================================================= -->
                    <!-- 2. SELECCIÓN DEL PROFESIONAL -->
                    <!-- ================================================= -->

                    <GridPane hgap="15.0"
                              vgap="12.0">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="30.0"/>
                            <ColumnConstraints percentWidth="35.0"/>
                            <ColumnConstraints percentWidth="35.0"/>
                        </columnConstraints>

                        <Label text="2. Selección del Profesional"
                               GridPane.columnSpan="3"
                               styleClass="label-section"/>

                        <ComboBox fx:id="cbEstilista"
                                  promptText="Seleccionar Profesional"
                                  GridPane.columnSpan="2"
                                  GridPane.rowIndex="1"
                                  styleClass="combo-box"/>

                    </GridPane>


                    <Separator/>


                    <!-- ================================================= -->
                    <!-- 3. SELECCIÓN DE SERVICIOS -->
                    <!-- ================================================= -->

                    <GridPane hgap="15.0"
                              vgap="12.0">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="65.0"/>
                            <ColumnConstraints percentWidth="35.0"/>
                        </columnConstraints>

                        <Label text="3. Selección de Servicios"
                               GridPane.columnSpan="2"
                               styleClass="label-section"/>

                        <ListView fx:id="lvServicios"
                                  prefHeight="200.0"
                                  GridPane.rowIndex="1"
                                  styleClass="list-view"/>

                        <VBox spacing="8.0"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="1">

                            <Label text="Servicios disponibles para el profesional:"
                                   styleClass="label-subsection"
                                   wrapText="true"/>

                            <Label fx:id="lblInstruccionesServicios"
                                   text="Seleccione uno o varios servicios."
                                   wrapText="true"
                                   styleClass="label-hint"/>

                            <Label fx:id="lblDuracionTotal"
                                   text="Duración Total Requerida: 0 minutos"
                                   wrapText="true"
                                   styleClass="label-note"/>

                        </VBox>

                    </GridPane>


                    <Separator/>


                    <!-- ================================================= -->
                    <!-- 4. FECHA Y TURNOS DISPONIBLES -->
                    <!-- ================================================= -->

                    <GridPane hgap="15.0"
                              vgap="12.0"
                              minHeight="300.0">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="30.0"/>
                            <ColumnConstraints percentWidth="35.0"/>
                            <ColumnConstraints percentWidth="35.0"/>
                        </columnConstraints>

                        <Label text="4. Fecha y Turnos Disponibles"
                               GridPane.columnSpan="3"
                               styleClass="label-section"/>

                        <DatePicker fx:id="dpFecha"
                                    promptText="Seleccionar Fecha"
                                    GridPane.rowIndex="1"
                                    styleClass="combo-box"/>

                        <Button fx:id="btnBuscarDisponibilidad"
                                text="🔍 Buscar Turnos Libres"
                                onAction="#handleBuscarDisponibilidad"
                                GridPane.columnIndex="1"
                                GridPane.columnSpan="2"
                                GridPane.rowIndex="1"
                                styleClass="action-button"/>

                        <ListView fx:id="lvTurnosDisponibles"
                                  prefHeight="220.0"
                                  minHeight="180.0"
                                  maxHeight="300.0"
                                  GridPane.columnSpan="3"
                                  GridPane.rowIndex="2"
                                  styleClass="list-view"/>

                    </GridPane>


                    <Separator/>


                    <!-- ================================================= -->
                    <!-- 5. OBSERVACIONES -->
                    <!-- ================================================= -->

                    <GridPane hgap="15.0"
                              vgap="12.0">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="65.0"/>
                            <ColumnConstraints percentWidth="35.0"/>
                        </columnConstraints>

                        <Label text="5. Observaciones"
                               GridPane.columnSpan="2"
                               styleClass="label-section"/>

                        <TextArea fx:id="txtObservaciones"
                                  promptText="Notas sobre el turno (Opcional)"
                                  prefRowCount="4"
                                  GridPane.columnSpan="2"
                                  GridPane.rowIndex="1"
                                  styleClass="text-area"/>

                    </GridPane>


                    <!-- ================================================= -->
                    <!-- BOTONES -->
                    <!-- ================================================= -->

                    <HBox spacing="15.0"
                          alignment="CENTER_RIGHT">

                        <Button fx:id="btnCancelar"
                                text="Cancelar"
                                onAction="#handleCancelar"
                                styleClass="menu-button-secondary"/>

                        <Button fx:id="btnAgendar"
                                text="✅ AGENDAR TURNO"
                                onAction="#handleAgendarTurno"
                                styleClass="action-button"/>

                    </HBox>

                </VBox>

            </children>

        </AnchorPane>

    </content>

</ScrollPane>

