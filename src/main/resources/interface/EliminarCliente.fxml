<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane styleClass="erp-root" prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.EliminarClienteController"
            stylesheets="@/resource/styles.css">
    <children>
        <VBox styleClass="erp-page"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Label text="DESACTIVAR CLIENTE" styleClass="label-header" />

                <VBox fx:id="vboxDatosCliente" styleClass="erp-card" disable="true">
                    <children>
                        <Label text="Cliente encontrado. Confirme la eliminación:" styleClass="label-section" />

                        <GridPane hgap="15.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="90.0" prefWidth="150.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="160.0" prefWidth="350.0" />
                            </columnConstraints>
                            <children>
                                <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                           editable="false" promptText="Nombre del cliente" styleClass="text-field" />

                                <Label text="Apellido:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="txtApellido" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                           editable="false" promptText="Apellido del cliente" styleClass="text-field" />
                            </children>
                        </GridPane>
                    </children>
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button fx:id="btnCancelar" text="CANCELAR" onAction="#handleCancelar"
                                styleClass="secondary-button" />
                        <Button fx:id="btnEliminar" text="DESACTIVAR CLIENTE" onAction="#handleEliminarCliente"
                                styleClass="danger-button" disable="true" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
